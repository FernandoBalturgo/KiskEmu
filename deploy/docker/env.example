# Copy to .env next to docker-compose.yml (deploy/docker/README.md).

# ZeroTier network to join (16 hex digits, from my.zerotier.com). Authorise the server node there once it shows up.
ZEROTIER_NETWORK_ID=

# The address players connect to. Empty: the server's ZeroTier address, found at startup. Set it for a VPN on the host
# (docker-compose.host-vpn.yml), or to pin one address.
AION_PUBLIC_ADDRESS=
# docker-compose.host-vpn.yml only: the host's VPN address the ports are published on (usually = AION_PUBLIC_ADDRESS).
AION_BIND_IP=

# The account site (port 8780) is always HTTPS (KiskLauncher refuses http://). A self-signed certificate is made for
# the address unless tls/cert.pem and tls/key.pem are in the state volume; the launcher download pins its thumbprint.

# Extra tools/server_env.py options of THIS repo (e.g. "--open-registration"); the rate, player-cap and
# --rates-profile options of the a2ps fork do not exist here (README).
AION_SERVER_ARGS=

# Database backups into ./backups: one every N hours, the newest K kept (before-migrate-*.dump files are never pruned).
AION_BACKUP_INTERVAL_HOURS=24
AION_BACKUP_KEEP=14

# Database volume (must exist: docker volume create <name>). Default a2core-postgres; see README "Upgrading PostgreSQL".
AION_PG_VOLUME=
